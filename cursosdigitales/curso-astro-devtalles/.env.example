# ==============================================
# ASTRO: El framework para sitios web orientados al contenido
# DevTalles - Variables de Entorno
# ==============================================
# Instrucciones: Copia este archivo como .env y completa los valores reales
# cp .env.example .env

# ---- SERVIDOR ASTRO ----
PORT=4321
HOST=0.0.0.0
NODE_ENV=development

# ---- SUPABASE (Sección 10+: Astro DB) ----
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ---- VARIABLES PÚBLICAS (accesibles en el cliente) ----
# Usar prefijo PUBLIC_ para exponer al navegador en Astro
PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ---- AUTENTICACIÓN (Sección 12-13: Auth.js) ----
AUTH_SECRET=tu-auth-secret-aqui
AUTH_TRUST_HOST=true

# ---- BASE DE DATOS (Sección 10: Astro DB) ----
ASTRO_DB_URL=file:local.db

# ---- DEPLOYMENT (opcional) ----
# VERCEL_URL=
# NETLIFY_SITE_ID=
